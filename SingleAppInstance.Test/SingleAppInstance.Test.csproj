<Project>
  <Sdk Name="MSTest.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <!-- A trimmed or Native AOT app runs with reflection-based System.Text.Json disabled, so the
         tests do too: a reflection call in the library fails every test that writes a PID file. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SingleAppInstance\SingleAppInstance.csproj" />
    <!-- Only to check that the PID file stays where AppData.Path put it before #221. -->
    <PackageReference Include="ktsu.AppDataStorage" />
  </ItemGroup>

</Project>
